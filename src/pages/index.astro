---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import portfolio from '../data/portfolio.json';
import ProjectLibrary from '../components/ProjectLibrary.astro';
const projects = portfolio.projects.filter(p => p.category !== 'Operations');
const featured = ['kp-forms', 'norteflow', 'smartfit'].map(id => projects.find(p => p.id === id)!);
const operations = portfolio.projects.find(p => p.id === 'digital-operations')!;
const skills = [
  { number: '01', title: 'Interfaces that make sense.', description: 'Responsive websites, usable dashboards, and thoughtful interactions.', stack: 'React · Next.js · TypeScript · Tailwind CSS' },
  { number: '02', title: 'Logic behind the experience.', description: 'APIs, relational data, authentication, and real business workflows.', stack: 'Spring Boot · Django · MySQL · Supabase' },
  { number: '03', title: 'A little beyond the browser.', description: 'AI integrations, data applications, and native mobile interfaces.', stack: 'Python · Streamlit · RAG · Kotlin' },
];
---
<Layout title="Nico Rivera — Developer & Digital Problem Solver" description="Nico Rivera’s portfolio: full-stack applications, thoughtful interfaces, and AI integrations. BSIT graduate, currently building a barangay case monitoring system for DILG.">
  <section class="shell hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span> {profile.status}</div>
      <h1 id="hero-heading">Thoughtful code.<br />Practical solutions.<br /><span>A human touch.</span></h1>
      <p class="hero-intro">I’m <strong>{profile.shortName}</strong>, a developer turning complex workflows into clear, useful digital experiences.</p>
      <p class="hero-detail">Currently building the Katarungang Pambarangay Online Monitoring System, helping DILG monitor cases across barangays.</p>
      <div class="button-row"><a class="button primary" href="#projects">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
      <div class="hero-location"><span aria-hidden="true">◎</span> Based in the Philippines <span class="separator">/</span> Building with purpose</div>
    </div>
    <div class="portrait-composition">
      <div class="portrait-top"><span>THE PERSON BEHIND THE CODE</span><span>01 / NR</span></div>
      <div class="portrait-frame"><img src="/me.jpg" alt="Nico Rivera" width="640" height="800" fetchpriority="high" /><div class="portrait-gradient"></div><div class="portrait-caption"><span>Hello, world.</span><strong>Nico Rivera<span class="gold">.</span></strong><span>Developer. Problem solver. Always learning.</span></div></div>
      <div class="portrait-stamp" aria-label="Code, create, keep growing"><span>CODE. CREATE.</span><strong>↗</strong><span>KEEP GROWING.</span></div>
      <div class="portrait-bottom"><span class="status-dot"></span><span>A new chapter. The same curiosity.</span></div>
    </div>
  </section>
  <div class="shell proof-strip"><div><strong>{projects.length.toString().padStart(2, '0')}</strong><span>documented projects</span></div><div><strong>Web + AI</strong><span>ideas into working systems</span></div><div><strong>People first</strong><span>in code and collaboration</span></div><a href={portfolio.source} target="_blank" rel="noopener noreferrer">The full portfolio sheet <span aria-hidden="true">↗</span></a></div>
  <section class="shell section" id="projects" aria-labelledby="work-heading">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="work-heading">Built to be <em>useful.</em></h2></div><p>A few things I’ve helped bring to life.<br />Real contributions, with the details to back them up.</p></div>
    <div class="featured-grid">
      {featured.map((project, i) => <article class={`feature-card feature-${project.id}`}>
        <a class="project-visual" href={`#project-${project.id}`} aria-label={`Read about ${project.title}`}>
          <div class="visual-top"><span>{i === 0 ? 'GOVERNMENT & CIVIC TECH' : i === 1 ? 'BUSINESS & FINANCE' : 'APPLIED ARTIFICIAL INTELLIGENCE'}</span><span>↗</span></div>
          {i === 0 ? <div class="forms-art"><div class="art-sidebar"><b>kp<span>.</span></b><i></i><i></i><i></i></div><div class="art-content"><small>DILG / OVERVIEW</small><strong>A clearer view.<br />Better workflows.</strong><div class="art-tiles"><span>Forms<br /><b>Organized.</b></span><span>Records<br /><b>Connected.</b></span></div><div class="art-lines"><i></i><i></i><i></i></div></div></div> : i === 1 ? <div class="finance-art"><span class="finance-symbol">₱</span><div><small>NORTEFLOW</small><strong>Clarity for<br />every peso.</strong><div class="finance-bars">{[35, 55, 44, 78, 60, 88, 100].map(h => <i style={`height:${h}%`}></i>)}</div></div></div> : <div class="ai-art"><div class="ai-orbit"><span>✳</span></div><strong>Context meets<br />capability.</strong><div class="ai-pills"><span>RAG</span><span>Function calling</span></div></div>}
          <span class="visual-note">Concept illustration · not an application screenshot</span>
        </a>
        <div class="feature-copy"><span class="project-number">0{i + 1} / {i === 0 ? 'Current project' : project.category}</span><h3>{i === 0 ? 'Katarungang Pambarangay' : project.title.split(' – ')[0]}</h3><p>{project.summary}</p><div class="tags">{project.stack.slice(0, 3).map(tag => <span>{tag}</span>)}</div><a class="text-link" href={`#project-${project.id}`}>Explore the contribution <span aria-hidden="true">↗</span></a></div>
      </article>)}
    </div>
    <ProjectLibrary />
  </section>
  <section class="experience-band" id="experience" aria-labelledby="experience-heading"><div class="shell section">
    <div class="section-heading"><div><p class="eyebrow">02 / EXPERIENCE & GROWTH</p><h2 id="experience-heading">More than <em>the code.</em></h2></div><p>Technical curiosity.<br />A practical understanding of the work.</p></div>
    <div class="experience-layout"><div class="chapter"><span class="status-dot"></span><p>THE CURRENT CHAPTER</p><h3>BSIT graduate.<br />Building.<br /><span>Ready for what’s next.</span></h3><p>I’m a Bachelor of Science in Information Technology graduate, currently focused on the Katarungang Pambarangay Online Monitoring System and open to opportunities to put my skills to work.</p></div>
      <div class="experience-list">
        <article><div class="experience-meta"><span>CURRENT PROJECT</span><span>Government & civic tech</span></div><h3>Katarungang Pambarangay<br />Online Monitoring System</h3><p>A system for DILG to monitor cases across barangays. I contribute to the DILG side through dashboard design, operational workflows, and backend development that supports case monitoring.</p><a class="text-link" href="#project-kp-forms">Explore my full-stack contribution ↗</a></article>
        <article><div class="experience-meta"><span>DIGITAL OPERATIONS</span><span>Hands-on experience</span></div><h3>E-commerce & digital support</h3><p>{operations.summary}</p><div class="tags"><span>Product uploads</span><span>QA / QC</span><span>Daily reporting</span></div><p class="brand-note">Brand support: Yovino · Toylandia · RetailMNL · Furnulem</p><a class="text-link" href={operations.links[0].url} target="_blank" rel="noopener noreferrer">View work samples ↗</a></article>
        <article><div class="experience-meta"><span>EDUCATION</span><span>Graduate</span></div><h3>{profile.degree}</h3><p>{profile.education}</p><p>A foundation in full-stack development, relational databases, and collaborative problem solving. Now applying that foundation beyond the classroom.</p></article>
      </div>
    </div>
  </div></section>
  <section class="shell section" id="about" aria-labelledby="about-heading">
    <div class="about-grid"><div><p class="eyebrow">03 / A LITTLE ABOUT ME</p><h2 id="about-heading">Curious by nature.<br /><em>Builder by choice.</em></h2></div><div class="about-copy"><p>I’m Nico, a BSIT graduate who enjoys making complicated things feel straightforward.</p><p>My projects and experience span web development, data applications, AI integrations, and digital support. That mix keeps me grounded: a good solution needs thoughtful engineering and an understanding of the people using it.</p><p>I’m continuing to grow toward building useful products and sustainable digital businesses. For me, the best part is taking an idea, working through the details, and making something that helps.</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">See what I’m building on GitHub ↗</a></div></div>
    <div class="skill-grid">{skills.map(skill => <article><span class="project-number">{skill.number} / HOW I BUILD</span><h3>{skill.title}</h3><p>{skill.description}</p><span class="skill-stack">{skill.stack}</span></article>)}</div>
  </section>
  <section class="shell contact-section" id="contact" aria-labelledby="contact-heading"><div class="contact-card"><p class="eyebrow">04 / LET’S CONNECT</p><h2 id="contact-heading">Good things start<br />with <em>a conversation.</em></h2><p>Have a project in mind, an interesting challenge,<br class="desktop-break" /> or just want to say hello? I’d love to hear from you.</p><a class="button primary" href={`mailto:${profile.email}`}>Say hello <span aria-hidden="true">↗</span></a><div class="contact-bottom"><a href={`mailto:${profile.email}`}>{profile.email}</a><button id="copy-email" data-email={profile.email}>Copy email <span aria-hidden="true">⧉</span></button><span id="copy-status" class="sr-only" role="status"></span><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div></section>
</Layout>
<script>
  const copy = document.querySelector<HTMLButtonElement>('#copy-email');
  copy?.addEventListener('click', async () => {
    const status = document.querySelector('#copy-status');
    try { await navigator.clipboard.writeText(copy.dataset.email!); copy.textContent = 'Copied ✓'; if (status) status.textContent = 'Email address copied.'; }
    catch { if (status) status.textContent = 'Could not copy. Please use the email link.'; copy.textContent = 'Use the email link'; }
  });
</script>
