<div class="max-w-2xl">
  <p class="text-gray-700 dark:text-gray-300 mb-6">
    Send me a message and it will be delivered to my email inbox.
  </p>

  <form
    action="https://formsubmit.co/rivera.nicon2020@gmail.com"
    method="POST"
    class="space-y-4"
  >
    <input type="hidden" name="_subject" value="New Portfolio Contact Message" />
    <input type="hidden" name="_captcha" value="false" />

    <div>
      <label for="name" class="block mb-2 text-sm font-medium text-gray-800 dark:text-gray-200">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label for="email" class="block mb-2 text-sm font-medium text-gray-800 dark:text-gray-200">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label for="message" class="block mb-2 text-sm font-medium text-gray-800 dark:text-gray-200">Message</label>
      <textarea
        id="message"
        name="message"
        required
        rows="6"
        class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
      ></textarea>
    </div>

    <button
      type="submit"
      class="rounded-xl border border-gray-300 dark:border-gray-700 px-5 py-3 font-medium text-gray-900 dark:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
    >
      Send Message
    </button>
  </form>
</div>