---
import portfolio from '../data/portfolio.json';
import ProjectReferences from './ProjectReferences.astro';
const projects = portfolio.projects.filter(p => p.category !== 'Operations');
const categories = ['All work', 'Web', 'Full-stack', 'Data & AI', 'Mobile'];
---
<div class="project-library" id="project-library">
  <div class="library-heading"><div><p class="eyebrow">THE PROJECT INDEX</p><h3>A closer look.</h3></div><a class="text-link" href={portfolio.source} target="_blank" rel="noopener noreferrer">View source sheet ↗</a></div>
  <p class="library-intro">Explore the work, my contribution, and the outcome. Open any project for the full story.</p>
  <div class="library-controls" id="library-controls" hidden>
    <div class="filter-list" role="group" aria-label="Filter projects by discipline">{categories.map((category, i) => <button class:list={['filter-button', { active: i === 0 }]} type="button" data-filter={category} aria-pressed={i === 0}>{category}</button>)}</div>
    <label class="search-field"><span aria-hidden="true">⌕</span><span class="sr-only">Search projects, technologies, or contributions</span><input type="search" id="project-search" placeholder="Search projects or skills…" /></label>
  </div>
  <div class="library-meta"><p id="project-count" role="status" aria-live="polite">{projects.length} projects</p><span>Curated from my portfolio sheet · October 2026</span></div>
  <div class="project-index">
    {projects.map((project, i) => <details class="project-entry" id={`project-${project.id}`} data-category={project.category} data-search={[project.title, project.id === 'kp-forms' ? 'Katarungang Pambarangay Online Monitoring System' : '', project.role, project.summary, project.contribution, ...project.stack].join(' ').toLowerCase()}>
      <summary><span class="index-number">{(i + 1).toString().padStart(2, '0')}</span><div class="entry-heading"><span class="project-number">{project.id === 'kp-forms' ? 'Current project / Full-stack' : project.category}</span><h4>{project.id === 'kp-forms' ? 'Katarungang Pambarangay / KP Forms' : project.title.split(' – ')[0]}</h4><p>{project.role}</p></div><span class="expand-icon" aria-hidden="true">+</span></summary>
      <div class="entry-content"><p class="entry-summary">{project.summary}</p><div class="tags">{project.stack.map(tag => <span>{tag}</span>)}</div><h5>My contribution</h5><p>{project.contribution}</p><h5>The outcome</h5><p>{project.outcome}</p><div class="proof-links">{project.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>{project.id === 'kp-forms' && <ProjectReferences />}<p class="access-note">External work samples may require permission from their owner.</p></div>
    </details>)}
  </div>
  <div class="empty-state" id="empty-state" hidden><h4>No projects found.</h4><p>Try another keyword or explore all the work.</p><button class="text-link" id="reset-projects" type="button">Clear filters ↗</button></div>
  <p class="source-note">A curated snapshot of my portfolio sheet. Repository and proof links open the original sources.</p>
</div>
<script>
  const controls = document.querySelector<HTMLElement>('#library-controls');
  const entries = [...document.querySelectorAll<HTMLDetailsElement>('.project-entry')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const search = document.querySelector<HTMLInputElement>('#project-search');
  const count = document.querySelector('#project-count');
  const empty = document.querySelector<HTMLElement>('#empty-state');
  let category = 'All work';
  if (controls) controls.hidden = false;
  function filterProjects() {
    const terms = (search?.value.toLowerCase().trim() ?? '').split(/\s+/).filter(Boolean);
    let total = 0;
    entries.forEach(entry => {
      const visible = (category === 'All work' || entry.dataset.category === category) && terms.every(term => entry.dataset.search?.includes(term));
      entry.hidden = !visible;
      if (visible) total++;
    });
    filters.forEach(button => { const active = button.dataset.filter === category; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); });
    if (count) count.textContent = `${total} of ${entries.length} projects`;
    if (empty) empty.hidden = total > 0;
  }
  filters.forEach(button => button.addEventListener('click', () => { category = button.dataset.filter!; filterProjects(); }));
  search?.addEventListener('input', filterProjects);
  function reset() { category = 'All work'; if (search) search.value = ''; filterProjects(); }
  document.querySelector('#reset-projects')?.addEventListener('click', reset);
  function revealHash() {
    const entry = entries.find(item => `#${item.id}` === location.hash);
    if (!entry) return;
    reset(); entry.open = true;
    requestAnimationFrame(() => entry.scrollIntoView({ block: 'start', behavior: 'instant' }));
  }
  window.addEventListener('hashchange', revealHash);
  // Repeated links to the same project must reopen a collapsed contribution.
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#project-"]').forEach(link => link.addEventListener('click', () => {
    if (link.hash === location.hash) revealHash();
  }));
  revealHash();
</script>
